# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL connection used by Prisma migrations and runtime.
# Production: shared `hbrl-postgres` container on the HardbanRecordsLab VPS, database `nova_campus`
# (created per G:\HBRL-VPS\DB-POLICY.md). App runs on the same host (PM2), so it connects via 127.0.0.1.
# Local dev: point at your own Postgres, or open an SSH tunnel to the VPS instance.
DATABASE_URL="postgresql://user:password@localhost:5432/hrl_nova_campus"

# Public hostname used for certificate verification and QR links.
APP_DOMAIN="localhost:3000"

# JWT_SECRET: Secret for signing JWT authentication tokens.
JWT_SECRET=

# Optional first-admin bootstrap password. Keep this value only in local/deployment secrets.
ADMIN_INITIAL_PASSWORD=

# STRIPE_SECRET_KEY: Secret key for Stripe API.
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Secret for verifying Stripe webhooks.
STRIPE_WEBHOOK_SECRET=

# Frontend-only (Vite, VITE_ prefix required to be embedded at build time).
# Set on Vercel when the frontend is deployed separately from this backend (see vercel.json).
# Points the browser's WebSocket connection at the VPS backend instead of same-origin.
# Leave unset when backend serves the built frontend itself (same-origin monolith).
VITE_WS_URL="wss://api.nova-campus.hardbanrecordslab.online"
